# ==============================================================================
# SmartSpace Python AI Service Environment Configuration
# Copy this file to .env and fill in your credentials.
# Note: .env is ignored by Git, so your keys will NEVER be committed to GitHub.
# ==============================================================================

# PostgreSQL Connection (accepts postgres:// URL or ASP.NET connection string)
DATABASE_URL="Host=localhost;Port=5432;Database=smartspace_db;Username=postgres;Password=your_password;SSL Mode=Prefer"

# JWT Authentication (matches ASP.NET Core appsettings.json)
JWT_SECRET_KEY="SmartSpaceSuperSecretKeyForJWTTokenSigning2026!"
JWT_ISSUER="SmartSpaceAPI"
JWT_AUDIENCE="SmartSpaceApps"

# ------------------------------------------------------------------------------
# Google Gemini API Keys (Get free key from: https://aistudio.google.com/)
# ------------------------------------------------------------------------------
# Inventory Search Agent & Inventory Assistant Key:
INVENTORY_AGENT_API_KEY="AIzaSyYourGeminiApiKeyHere"
INVENTORY_AGENT_MODEL="gemini-2.5-flash"

# Other Agents (You can use the same Gemini API key for all four for testing):
TRIAGE_AGENT_API_KEY="AIzaSyYourGeminiApiKeyHere"
TRIAGE_AGENT_MODEL="gemini-2.5-flash"

POLICY_AGENT_API_KEY="AIzaSyYourGeminiApiKeyHere"
POLICY_AGENT_MODEL="gemini-2.5-flash"

SCHEDULING_AGENT_API_KEY="AIzaSyYourGeminiApiKeyHere"
SCHEDULING_AGENT_MODEL="gemini-2.5-flash"

# Service Limits & Tuning
AI_MAX_OUTPUT_TOKENS=250
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=30
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
